# Copia este archivo como .env para probar en local, o pon estas variables en Portainer.

# Usuario y contraseña del panel (se entra tocando el logo de la web)
ADMIN_USER=soño
ADMIN_PASSWORD=cambia-esta-contraseña

# Puerto del servidor donde se publica la web
PUERTO=8081

# true si la web va detrás de un proxy (Nginx Proxy Manager, Traefik, Cloudflare Tunnel…)
TRUST_PROXY=true

# auto: cookie segura cuando la web se sirve por HTTPS. Valores: auto, true, false
COOKIE_SECURE=auto
